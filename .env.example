# Copy this file to .env and fill in ONE of the two options below.
# .env is ignored by git. Never commit a real key.

# Option 1: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Option 2: Vertex AI on Google Cloud (leave GOOGLE_API_KEY empty).
# Run: gcloud auth application-default login
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Model used for contract drafting and live area lookup.
# Default is gemini-3.8-flash. Pin a stable model, not a preview.
PWT_MODEL=gemini-3.8-flash

# Set to 0 to turn off live web-search lookup of representatives.
PWT_LIVE_LEADERS=1
